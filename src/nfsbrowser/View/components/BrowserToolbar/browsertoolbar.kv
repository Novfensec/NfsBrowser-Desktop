<BrowserToolbar>:
    size_hint: 1, None
    height: tab_header.height

    CBoxLayout:
        adaptive: [False, True]
        spacing: dp(8)

        CTabHeader:
            id: tab_header
            adaptive: [True, True]
            padding: dp(2)
            pos_hint: {"center_y": 0.5}

            # Tabs are generated dynamically in python

        ActiveButton:
            id: add_tab_btn
            icon: "add--large"
            font_size: plex_16

